{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/pre-commit-branch-guard.sh" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/branch-needs-worktree.sh" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/skill-size-check.sh" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/pre-commit-check.sh 2>/dev/null || true" }
        ]
      }
    ]
  }
}
